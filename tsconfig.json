{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"noEmit": true,
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"baseUrl": ".",
		"paths": {
			"@kicad-io/*": [
				"../../shared/kicad-io/src/*",
				"shared/kicad-io/src/*"
			],
			"@kicad-render/*": [
				"../../shared/kicad-render/*",
				"shared/kicad-render/*"
			],
			"@kicad-layout/*": [
				"../../shared/kicad-layout/*",
				"shared/kicad-layout/*"
			],
			"@clipper2-ts/*": [
				"../../shared/clipper2-ts/src/*",
				"shared/clipper2-ts/src/*"
			],
			"@zstd-ts/*": [
				"../../shared/zstd-ts/src/*",
				"shared/zstd-ts/src/*"
			]
		}
	},
	"include": [
		"src/**/*.ts",
		"../../shared/kicad-layout/**/*.ts",
		"../../shared/kicad-render/**/*.ts",
		"../../shared/kicad-io/src/**/*.ts",
		"../../shared/clipper2-ts/src/**/*.ts",
		"../../shared/zstd-ts/src/**/*.ts",
		"shared/kicad-layout/**/*.ts",
		"shared/kicad-render/**/*.ts",
		"shared/kicad-io/src/**/*.ts",
		"shared/clipper2-ts/src/**/*.ts",
		"shared/zstd-ts/src/**/*.ts"
	],
	"exclude": [
		"../../shared/kicad-render/tests/**",
		"shared/kicad-render/tests/**"
	]
}
